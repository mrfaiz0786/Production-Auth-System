{
  "info": {
    "_postman_id": "strong-auth-collection",
    "name": "Strong Auth Backend - Full Test Collection",
    "description": "Production auth API collection for Postman testing. Includes register, login, refresh, profile, admin routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","register"] },
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Strong@123\",\"confirmPassword\":\"Strong@123\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "2. Verify Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/verify-email", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","verify-email"] },
        "body": { "mode": "raw", "raw": "{\"token\":\"<emailVerificationToken>\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "3. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","login"] },
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Strong@123\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "4. Profile (Auth Required)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/profile", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","profile"] }
      }
    },
    {
      "name": "5. Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/refresh", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","refresh"] },
        "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "6. Logout (Single)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/logout", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","logout"] },
        "body": { "mode": "raw", "raw": "{\"sessionId\":\"{{sessionId}}\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "7. Logout All",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/logout-all", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","logout-all"] }
      }
    },
    {
      "name": "8. Change Password",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/change-password", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","change-password"] },
        "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Strong@123\",\"newPassword\":\"NewPass@456\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "9. Request Password Reset",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/request-password-reset", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","request-password-reset"] },
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\"}", "options": { "raw": { "language": "json" } } }
      }
    },
    {
      "name": "10. Admin - List All Users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/users", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","users"] }
      }
    },
    {
      "name": "11. Admin - Update User Role",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:3000/api/auth/user/{{userId}}/role", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api","auth","user","{{userId}}","role"] },
        "body": { "mode": "raw", "raw": "{\"role\":\"admin\"}", "options": { "raw": { "language": "json" } } }
      }
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "eyJ...", "type": "string" },
    { "key": "refreshToken", "value": "abc...", "type": "string" },
    { "key": "sessionId", "value": "662...", "type": "string" },
    { "key": "adminAccessToken", "value": "eyJ...admin", "type": "string" },
    { "key": "userId", "value": "662...", "type": "string" }
  ]
}
